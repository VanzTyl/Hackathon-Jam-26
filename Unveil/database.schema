-- CIIT Unveil Database Schema for Supabase (Prototype Mode)
-- This schema supports anonymous mentoring via masked identities
-- Separate accounts for mentee and mentor modes
-- RLS DISABLED for easy prototyping and testing
-- Foreign Keys ENABLED for relationship queries

-- Enable required extensions
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- Main Users Table (authentication data, not roles)
CREATE TABLE IF NOT EXISTS users (
  user_id UUID PRIMARY KEY,
  first_name VARCHAR(100) NOT NULL,
  last_name VARCHAR(100) NOT NULL,
  email_address VARCHAR(255) NOT NULL UNIQUE,
  current_mask VARCHAR(10) DEFAULT 'student' CHECK (current_mask IN ('student', 'mentor')),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL,
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL
);

-- Mentees Table (student role accounts)
CREATE TABLE IF NOT EXISTS mentees (
  mentee_id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
  masked_name VARCHAR(100) NOT NULL UNIQUE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL,
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL,
  UNIQUE(user_id, masked_name)
);

-- Mentors Table (mentor role accounts)
CREATE TABLE IF NOT EXISTS mentors (
  mentor_id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
  masked_name VARCHAR(100) NOT NULL UNIQUE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL,
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL,
  UNIQUE(user_id, masked_name)
);

-- Signals Table (linked to user, not specific role)
CREATE TABLE IF NOT EXISTS signals (
  signal_id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID NOT NULL REFERENCES users(user_id),
  title VARCHAR(200) NOT NULL,
  description TEXT NOT NULL,
  tags TEXT[] NOT NULL DEFAULT '{}',
  masked_name VARCHAR(100),
  status VARCHAR(20) NOT NULL DEFAULT 'open' CHECK (status IN ('open', 'waiting_for_approval', 'helping', 'closed')),
  assigned_mentor_user_id UUID REFERENCES users(user_id),
  assigned_at TIMESTAMP WITH TIME ZONE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL,
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL
);

-- Signal Chat Table
CREATE TABLE IF NOT EXISTS signalChat (
  signalChatID UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  signal_id UUID NOT NULL REFERENCES signals(signal_id),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL
);

-- Signal Chat Users Table
CREATE TABLE IF NOT EXISTS signalChatUsers (
  signalChatID UUID NOT NULL REFERENCES signalChat(signalChatID),
  user_id UUID NOT NULL REFERENCES users(user_id),
  role VARCHAR(20) NOT NULL CHECK (role IN ('student', 'mentor')),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL,
  PRIMARY KEY (signalChatID, user_id)
);

-- Signal Messages Table
CREATE TABLE IF NOT EXISTS signalMessages (
  message_id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  signalChatID UUID NOT NULL REFERENCES signalChat(signalChatID),
  sender_id UUID NOT NULL REFERENCES users(user_id),
  content TEXT NOT NULL,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL
);

-- Forum Posts Table
CREATE TABLE IF NOT EXISTS forum_posts (
  post_id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID NOT NULL REFERENCES users(user_id),
  title VARCHAR(200) NOT NULL,
  content TEXT NOT NULL,
  tags TEXT[] NOT NULL DEFAULT '{}',
  is_anonymous BOOLEAN NOT NULL DEFAULT FALSE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL,
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL
);

-- Forum Responses Table
CREATE TABLE IF NOT EXISTS forum_responses (
  response_id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  post_id UUID NOT NULL REFERENCES forum_posts(post_id) ON DELETE CASCADE,
  user_id UUID NOT NULL REFERENCES users(user_id),
  content TEXT NOT NULL,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL
);

-- Forum Bookmarks Table
CREATE TABLE IF NOT EXISTS forum_bookmarks (
  bookmark_id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID NOT NULL REFERENCES users(user_id),
  post_id UUID NOT NULL REFERENCES forum_posts(post_id) ON DELETE CASCADE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL,
  UNIQUE(user_id, post_id)
);

-- User Connections Table
CREATE TABLE IF NOT EXISTS connections (
  connection_id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
  connected_user_id UUID NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
  status VARCHAR(20) NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'accepted')),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL,
  UNIQUE(user_id, connected_user_id)
);

-- Create indexes for better query performance
CREATE INDEX IF NOT EXISTS idx_signals_user_id ON signals(user_id);
CREATE INDEX IF NOT EXISTS idx_signals_status ON signals(status);
CREATE INDEX IF NOT EXISTS idx_signals_created_at ON signals(created_at DESC);
CREATE INDEX IF NOT EXISTS idx_signalChat_signal_id ON signalChat(signal_id);
CREATE INDEX IF NOT EXISTS idx_signalChatUsers_signalChatID ON signalChatUsers(signalChatID);
CREATE INDEX IF NOT EXISTS idx_signalChatUsers_user_id ON signalChatUsers(user_id);
CREATE INDEX IF NOT EXISTS idx_signalMessages_signalChatID ON signalMessages(signalChatID);
CREATE INDEX IF NOT EXISTS idx_signalMessages_created_at ON signalMessages(created_at);
CREATE INDEX IF NOT EXISTS idx_mentees_user_id ON mentees(user_id);
CREATE INDEX IF NOT EXISTS idx_mentors_user_id ON mentors(user_id);
CREATE INDEX IF NOT EXISTS idx_forum_posts_user_id ON forum_posts(user_id);
CREATE INDEX IF NOT EXISTS idx_forum_posts_created_at ON forum_posts(created_at DESC);
CREATE INDEX IF NOT EXISTS idx_forum_responses_post_id ON forum_responses(post_id);
CREATE INDEX IF NOT EXISTS idx_forum_bookmarks_user_id ON forum_bookmarks(user_id);
CREATE INDEX IF NOT EXISTS idx_connections_user_id ON connections(user_id);
CREATE INDEX IF NOT EXISTS idx_connections_connected_user_id ON connections(connected_user_id);

-- DISABLE ROW LEVEL SECURITY for easy prototyping
ALTER TABLE users DISABLE ROW LEVEL SECURITY;
ALTER TABLE signals DISABLE ROW LEVEL SECURITY;
ALTER TABLE signalChat DISABLE ROW LEVEL SECURITY;
ALTER TABLE signalChatUsers DISABLE ROW LEVEL SECURITY;
ALTER TABLE signalMessages DISABLE ROW LEVEL SECURITY;
ALTER TABLE mentees DISABLE ROW LEVEL SECURITY;
ALTER TABLE mentors DISABLE ROW LEVEL SECURITY;
ALTER TABLE forum_posts DISABLE ROW LEVEL SECURITY;
ALTER TABLE forum_responses DISABLE ROW LEVEL SECURITY;
ALTER TABLE forum_bookmarks DISABLE ROW LEVEL SECURITY;
ALTER TABLE connections DISABLE ROW LEVEL SECURITY;

-- Function to update updated_at timestamp
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = TIMEZONE('utc'::text, NOW());
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Drop existing triggers if they exist
DROP TRIGGER IF EXISTS update_users_updated_at ON users;
DROP TRIGGER IF EXISTS update_signals_updated_at ON signals;
DROP TRIGGER IF EXISTS update_mentees_updated_at ON mentees;
DROP TRIGGER IF EXISTS update_mentors_updated_at ON mentors;

-- Create triggers for updated_at
CREATE TRIGGER update_users_updated_at
  BEFORE UPDATE ON users
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

CREATE TRIGGER update_signals_updated_at
  BEFORE UPDATE ON signals
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

CREATE TRIGGER update_mentees_updated_at
  BEFORE UPDATE ON mentees
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

CREATE TRIGGER update_mentors_updated_at
  BEFORE UPDATE ON mentors
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

-- Comments for documentation
COMMENT ON TABLE users IS 'Main user table with authentication data (not role-specific)';
COMMENT ON TABLE mentees IS 'Student/Mentee accounts - separate identities for seeking help';
COMMENT ON TABLE mentors IS 'Mentor accounts - separate identities for providing help';
COMMENT ON COLUMN mentees.masked_name IS 'Anonymous identity when in mentee mode';
COMMENT ON COLUMN mentors.masked_name IS 'Anonymous identity when in mentor mode';
COMMENT ON TABLE signals IS 'Main table for help requests/signals from users';
COMMENT ON TABLE signalChat IS 'Chat rooms created for each signal';
COMMENT ON TABLE signalChatUsers IS 'Tracks users participating in signal chats';
COMMENT ON TABLE signalMessages IS 'Messages sent within signal chat rooms';
COMMENT ON TABLE forum_posts IS 'Forum posts and discussions';
COMMENT ON TABLE forum_responses IS 'Comments/responses to forum posts';
COMMENT ON TABLE forum_bookmarks IS 'Users bookmarked forum posts';
COMMENT ON TABLE connections IS 'User connections and mentor/mentee relationships';
COMMENT ON COLUMN signals.status IS 'Signal lifecycle: open, in_progress, closed';
COMMENT ON COLUMN signals.tags IS 'Array of tags for categorizing help requests';
COMMENT ON COLUMN connections.status IS 'Connection status: pending, accepted';
